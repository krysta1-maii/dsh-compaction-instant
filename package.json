{
  "name": "dsh-compaction-instant",
  "version": "0.5.0",
  "icon": "./assets/icon.svg",
  "description": "VCC-style instant, near-lossless deterministic compaction backend for DeepSeek Harness 0.2.x",
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./compiler": {
      "types": "./types/compiler.d.ts",
      "default": "./src/compiler.js"
    },
    "./region": {
      "types": "./types/region.d.ts",
      "default": "./src/region.js"
    },
    "./recall": {
      "types": "./types/recall.d.ts",
      "default": "./src/recall.js"
    },
    "./search": {
      "types": "./types/search.d.ts",
      "default": "./src/search.js"
    },
    "./tool": {
      "types": "./types/tool.d.ts",
      "default": "./src/tool.js"
    },
    "./command": {
      "types": "./types/command.d.ts",
      "default": "./src/command.js"
    },
    "./settings": {
      "types": "./types/settings.d.ts",
      "default": "./src/settings.js"
    },
    "./preset-tools": {
      "types": "./types/preset-tools.d.ts",
      "default": "./src/preset-tools.js"
    },
    "./package.json": "./package.json",
    "./tool/icon": "./assets/icon.svg",
    "./command/icon": "./assets/icon.svg",
    "./settings/icon": "./assets/icon.svg",
    "./preset-tools/icon": "./assets/icon.svg",
    "./client": {
      "default": "./src/client.js"
    }
  },
  "files": [
    "assets",
    "src",
    "types",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test",
    "check": "npm run check:syntax && npm run typecheck",
    "check:syntax": "node --check src/index.js && node --check src/compiler.js && node --check src/region.js && node --check src/recall.js && node --check src/search.js && node --check src/tool.js && node --check src/ptc.js && node --check src/command.js && node --check src/preset-tools.js && node --check src/settings.js && node --check src/client.js && node --check scripts/check-package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "node scripts/check-package.mjs"
  },
  "engines": {
    "node": ">=22.12.0",
    "dsh": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-alpha.3"
  },
  "packageManager": "npm@9.2.0",
  "keywords": [
    "cordis",
    "dsh",
    "deepseek-harness",
    "compaction",
    "context-compression",
    "vcc",
    "token"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-util-values": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-alpha.3",
    "@deepseek-ai/schemastery": "^3.18.4 || ^3.18.5-0 || ^3.18.6-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4 || ^4.0.5-0 || ^4.0.6-alpha.2",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-alpha.3",
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-alpha.3",
    "@deepseek-ai/dsh-compaction": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-alpha.3",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-alpha.3",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-alpha.3",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-alpha.3",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-alpha.3",
    "@deepseek-ai/dsh-token-meter": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-alpha.3",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-alpha.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-commands": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-compaction": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-scope": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-settings": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-token-meter": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.3",
    "@deepseek-ai/schemastery": "3.18.6-alpha.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction-tool-result-pruner": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "author": "TsFreddie",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TsFreddie/dsh-compaction-instant.git"
  },
  "bugs": {
    "url": "https://github.com/TsFreddie/dsh-compaction-instant/issues"
  },
  "homepage": "https://github.com/TsFreddie/dsh-compaction-instant#readme"
}
